{
  "name": "mcp-smart-typer-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Experimental MCP typing contracts, a mock TypeScript server, and Windows native-helper prototypes",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare-release": "node scripts/prepare-release.js",
    "validate-cicd": "node scripts/validate-release-boundary.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mock-server",
    "schema-validation",
    "windows",
    "ui-automation"
  ],
  "author": "MCP Smart Typer Team",
  "license": "MIT",
  "mcpSpecVersion": "1.0.0"
}
