{
  "name": "mcp-smart-typer-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "MCP Smart Typer - AI-powered typing automation with Windows UI integration",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "prepare-release": "node scripts/prepare-release.js",
    "validate-cicd": "node scripts/validate-release-boundary.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "automation",
    "typing",
    "windows",
    "ui-automation"
  ],
  "author": "MCP Smart Typer Team",
  "license": "MIT",
  "mcpSpecVersion": "1.0.0"
}
