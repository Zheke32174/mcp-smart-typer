{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.mcp-smart-typer.dev/all-schemas.json",
  "title": "MCP Smart Typer - All Schemas",
  "description": "Combined JSON Schema definitions for all MCP Smart Typer tools",
  "type": "object",
  "properties": {
    "detect-fields-request": {
      "$ref": "definitions/detect-fields-request",
      "definitions": {
        "detect-fields-request": {
          "type": "object",
          "properties": {
            "contextHint": {
              "type": "string",
              "description": "Context hint for field detection (e.g., \"login-form\", \"search-box\")"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            },
            "windowTitle": {
              "type": "string",
              "description": "Specific window title to focus on"
            },
            "includeHidden": {
              "type": "boolean",
              "default": false,
              "description": "Whether to include hidden fields"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.8,
              "description": "Minimum confidence threshold for detection"
            }
          },
          "required": [
            "contextHint"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for detecting fields in the active window",
      "example": {
        "contextHint": "login-form",
        "securityFlags": [
          "authenticated"
        ],
        "windowTitle": "Login - My App",
        "includeHidden": false,
        "confidence": 0.8
      },
      "$id": "https://schemas.mcp-smart-typer.dev/detect-fields-request.json"
    },
    "detect-fields-response": {
      "$ref": "definitions/detect-fields-response",
      "definitions": {
        "detect-fields-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique field identifier"
                  },
                  "name": {
                    "type": "string",
                    "description": "Field name or label"
                  },
                  "type": {
                    "type": "string",
                    "description": "Field type (input, textarea, select, etc.)"
                  },
                  "metadata": {
                    "type": "object",
                    "properties": {
                      "description": {
                        "type": "string",
                        "description": "Field description"
                      },
                      "placeholder": {
                        "type": "string",
                        "description": "Field placeholder text"
                      },
                      "maxLength": {
                        "type": "number",
                        "description": "Maximum input length"
                      },
                      "inputType": {
                        "type": "string",
                        "enum": [
                          "text",
                          "password",
                          "email",
                          "number",
                          "tel",
                          "url"
                        ],
                        "description": "Input field type"
                      },
                      "required": {
                        "type": "boolean",
                        "description": "Whether field is required"
                      },
                      "pattern": {
                        "type": "string",
                        "description": "Validation pattern regex"
                      },
                      "bounds": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "width": {
                            "type": "number"
                          },
                          "height": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "width",
                          "height"
                        ],
                        "additionalProperties": false,
                        "description": "Field coordinates and dimensions"
                      },
                      "confidence": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Detection confidence score"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "name",
                  "type"
                ],
                "additionalProperties": false
              },
              "description": "List of detected fields with metadata"
            },
            "windowInfo": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "className": {
                  "type": "string"
                },
                "handle": {
                  "type": "string"
                },
                "bounds": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "className",
                "handle",
                "bounds"
              ],
              "additionalProperties": false,
              "description": "Information about the active window"
            }
          },
          "required": [
            "fields"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for field detection results",
      "example": {
        "fields": [
          {
            "id": "field_username_001",
            "name": "username",
            "type": "input",
            "metadata": {
              "description": "Username input field",
              "inputType": "text",
              "required": true,
              "bounds": {
                "x": 100,
                "y": 200,
                "width": 200,
                "height": 30
              },
              "confidence": 0.95
            }
          },
          {
            "id": "field_password_002",
            "name": "password",
            "type": "input",
            "metadata": {
              "description": "Password input field",
              "inputType": "password",
              "required": true,
              "bounds": {
                "x": 100,
                "y": 250,
                "width": 200,
                "height": 30
              },
              "confidence": 0.92
            }
          }
        ],
        "windowInfo": {
          "title": "Login - My App",
          "className": "Chrome_WidgetWin_1",
          "handle": "0x001234AB",
          "bounds": {
            "x": 0,
            "y": 0,
            "width": 1920,
            "height": 1080
          }
        }
      },
      "$id": "https://schemas.mcp-smart-typer.dev/detect-fields-response.json"
    },
    "type-text-request": {
      "$ref": "definitions/type-text-request",
      "definitions": {
        "type-text-request": {
          "type": "object",
          "properties": {
            "fieldId": {
              "type": "string",
              "description": "Target field identifier"
            },
            "text": {
              "type": "string",
              "description": "Text to type"
            },
            "options": {
              "type": "object",
              "properties": {
                "delay": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5000,
                  "default": 50,
                  "description": "Delay between keystrokes in milliseconds"
                },
                "clearFirst": {
                  "type": "boolean",
                  "default": false,
                  "description": "Clear field before typing"
                },
                "pressEnter": {
                  "type": "boolean",
                  "default": false,
                  "description": "Press Enter after typing"
                },
                "simulate": {
                  "type": "boolean",
                  "default": false,
                  "description": "Simulate typing without actual input (for testing)"
                }
              },
              "additionalProperties": false
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            }
          },
          "required": [
            "fieldId",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for typing text into a field",
      "example": {
        "fieldId": "field_username_001",
        "text": "john.doe@example.com",
        "options": {
          "delay": 50,
          "clearFirst": true,
          "pressEnter": false,
          "simulate": false
        },
        "securityFlags": [
          "encrypted"
        ]
      },
      "$id": "https://schemas.mcp-smart-typer.dev/type-text-request.json"
    },
    "type-text-response": {
      "$ref": "definitions/type-text-response",
      "definitions": {
        "type-text-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "success": {
              "type": "boolean",
              "description": "Whether typing was successful"
            },
            "charactersTyped": {
              "type": "number",
              "description": "Number of characters successfully typed"
            },
            "timeTaken": {
              "type": "number",
              "description": "Time taken to complete operation in milliseconds"
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for text typing results",
      "example": {
        "success": true,
        "charactersTyped": 19,
        "timeTaken": 950,
        "asyncJobId": "job_12345"
      },
      "$id": "https://schemas.mcp-smart-typer.dev/type-text-response.json"
    },
    "get-field-value-request": {
      "$ref": "definitions/get-field-value-request",
      "definitions": {
        "get-field-value-request": {
          "type": "object",
          "properties": {
            "fieldId": {
              "type": "string",
              "description": "Field identifier to read from"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            },
            "maxLength": {
              "type": "number",
              "default": 10000,
              "description": "Maximum length of value to retrieve"
            }
          },
          "required": [
            "fieldId"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for retrieving field values",
      "$id": "https://schemas.mcp-smart-typer.dev/get-field-value-request.json"
    },
    "get-field-value-response": {
      "$ref": "definitions/get-field-value-response",
      "definitions": {
        "get-field-value-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "value": {
              "type": "string",
              "description": "Current field value"
            },
            "fieldInfo": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique field identifier"
                },
                "name": {
                  "type": "string",
                  "description": "Field name or label"
                },
                "type": {
                  "type": "string",
                  "description": "Field type (input, textarea, select, etc.)"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string",
                      "description": "Field description"
                    },
                    "placeholder": {
                      "type": "string",
                      "description": "Field placeholder text"
                    },
                    "maxLength": {
                      "type": "number",
                      "description": "Maximum input length"
                    },
                    "inputType": {
                      "type": "string",
                      "enum": [
                        "text",
                        "password",
                        "email",
                        "number",
                        "tel",
                        "url"
                      ],
                      "description": "Input field type"
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Whether field is required"
                    },
                    "pattern": {
                      "type": "string",
                      "description": "Validation pattern regex"
                    },
                    "bounds": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false,
                      "description": "Field coordinates and dimensions"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Detection confidence score"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "name",
                "type"
              ],
              "additionalProperties": false,
              "description": "Updated field information"
            },
            "isSecure": {
              "type": "boolean",
              "description": "Whether field contains sensitive data"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for field value retrieval",
      "$id": "https://schemas.mcp-smart-typer.dev/get-field-value-response.json"
    },
    "focus-field-request": {
      "$ref": "definitions/focus-field-request",
      "definitions": {
        "focus-field-request": {
          "type": "object",
          "properties": {
            "fieldId": {
              "type": "string",
              "description": "Field identifier to focus"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            },
            "bringToFront": {
              "type": "boolean",
              "default": true,
              "description": "Whether to bring window to front"
            },
            "scrollIntoView": {
              "type": "boolean",
              "default": true,
              "description": "Whether to scroll field into view"
            }
          },
          "required": [
            "fieldId"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for focusing a field",
      "$id": "https://schemas.mcp-smart-typer.dev/focus-field-request.json"
    },
    "focus-field-response": {
      "$ref": "definitions/focus-field-response",
      "definitions": {
        "focus-field-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "success": {
              "type": "boolean",
              "description": "Whether focus was successful"
            },
            "previousFocus": {
              "type": "string",
              "description": "Previously focused element ID"
            },
            "windowBroughtToFront": {
              "type": "boolean",
              "default": false,
              "description": "Whether window was brought to front"
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for field focusing results",
      "$id": "https://schemas.mcp-smart-typer.dev/focus-field-response.json"
    },
    "clear-field-request": {
      "$ref": "definitions/clear-field-request",
      "definitions": {
        "clear-field-request": {
          "type": "object",
          "properties": {
            "fieldId": {
              "type": "string",
              "description": "Field identifier to clear"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            },
            "method": {
              "type": "string",
              "enum": [
                "selectAll",
                "backspace",
                "delete"
              ],
              "default": "selectAll",
              "description": "Method to clear field"
            }
          },
          "required": [
            "fieldId"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for clearing field content",
      "$id": "https://schemas.mcp-smart-typer.dev/clear-field-request.json"
    },
    "clear-field-response": {
      "$ref": "definitions/clear-field-response",
      "definitions": {
        "clear-field-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "success": {
              "type": "boolean",
              "description": "Whether clearing was successful"
            },
            "previousValue": {
              "type": "string",
              "description": "Previous field value (if not secure)"
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for field clearing results",
      "$id": "https://schemas.mcp-smart-typer.dev/clear-field-response.json"
    },
    "get-window-info-request": {
      "$ref": "definitions/get-window-info-request",
      "definitions": {
        "get-window-info-request": {
          "type": "object",
          "properties": {
            "windowTitle": {
              "type": "string",
              "description": "Specific window title to get info for"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            }
          },
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for retrieving window information",
      "$id": "https://schemas.mcp-smart-typer.dev/get-window-info-request.json"
    },
    "get-window-info-response": {
      "$ref": "definitions/get-window-info-response",
      "definitions": {
        "get-window-info-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "windows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "className": {
                    "type": "string"
                  },
                  "handle": {
                    "type": "string"
                  },
                  "pid": {
                    "type": "number"
                  },
                  "isActive": {
                    "type": "boolean"
                  },
                  "bounds": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number"
                      },
                      "height": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "title",
                  "className",
                  "handle",
                  "pid",
                  "isActive",
                  "bounds"
                ],
                "additionalProperties": false
              },
              "description": "List of available windows"
            },
            "activeWindow": {
              "type": "string",
              "description": "Handle of currently active window"
            }
          },
          "required": [
            "windows"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for window information",
      "$id": "https://schemas.mcp-smart-typer.dev/get-window-info-response.json"
    },
    "take-screenshot-request": {
      "$ref": "definitions/take-screenshot-request",
      "definitions": {
        "take-screenshot-request": {
          "type": "object",
          "properties": {
            "region": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false,
              "description": "Specific region to capture"
            },
            "securityFlags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Security flags for operation validation"
            },
            "format": {
              "type": "string",
              "enum": [
                "png",
                "jpeg"
              ],
              "default": "png",
              "description": "Image format"
            },
            "quality": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 90,
              "description": "Image quality for JPEG"
            }
          },
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Request schema for taking screenshots",
      "$id": "https://schemas.mcp-smart-typer.dev/take-screenshot-request.json"
    },
    "take-screenshot-response": {
      "$ref": "definitions/take-screenshot-response",
      "definitions": {
        "take-screenshot-response": {
          "type": "object",
          "properties": {
            "asyncJobId": {
              "type": "string",
              "description": "Async job ID for tracking long-running operations"
            },
            "errorCode": {
              "type": "string",
              "description": "Error code if operation failed"
            },
            "errorMessage": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "success": {
              "type": "boolean",
              "description": "Whether screenshot was taken"
            },
            "imageData": {
              "type": "string",
              "description": "Base64 encoded image data"
            },
            "imageSize": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "description": "Image dimensions"
            },
            "filePath": {
              "type": "string",
              "description": "Path to saved screenshot file"
            }
          },
          "required": [
            "success"
          ],
          "additionalProperties": false
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Response schema for screenshot results",
      "$id": "https://schemas.mcp-smart-typer.dev/take-screenshot-response.json"
    }
  },
  "definitions": {
    "securityFlags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Security flags for operation validation"
    },
    "asyncJobId": {
      "type": "string",
      "description": "Async job ID for tracking long-running operations"
    },
    "errorCode": {
      "type": "string",
      "description": "Error code if operation failed"
    },
