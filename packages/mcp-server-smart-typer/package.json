{
  "name": "@mcp-smart-typer/server",
  "version": "2.0.0",
  "description": "Schema-validated development MCP server with a mock Windows UI adapter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcp-server-smart-typer": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:release",
    "build:release": "tsc -p tsconfig.release.json",
    "dev": "tsx --watch src/simple-server.ts",
    "dev:enhanced": "tsx --watch src/enhanced-server.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/simple-server.ts",
    "start:enhanced": "tsx src/enhanced-server.ts",
    "test": "npm run test:release",
    "test:release": "node scripts/verify-release-surface.mjs",
    "test:e2e": "tsx src/test/run-e2e-tests.ts",
    "test:field-detection": "jest src/test/e2e/field-detection.test.ts",
    "test:typing-accuracy": "jest src/test/e2e/typing-accuracy.test.ts",
    "test:notepad": "jest src/test/e2e/notepad-integration.test.ts",
    "test:all": "jest && npm run test:e2e",
    "demo:generate": "tsx src/test/generate-demo-gifs.ts",
    "lint": "npm run lint:release",
    "lint:release": "eslint src/index.ts src/simple-server.ts src/schemas/index.ts src/utils/job-manager.ts src/utils/logger.ts src/utils/mock-native-client.ts",
    "format": "prettier --write src/index.ts src/simple-server.ts src/schemas/index.ts src/utils/job-manager.ts src/utils/logger.ts src/utils/mock-native-client.ts",
    "clean": "rimraf dist",
    "typecheck": "npm run typecheck:release",
    "typecheck:release": "tsc -p tsconfig.release.json --noEmit",
    "generate-schemas": "tsx scripts/generate-json-schemas.ts",
    "prebuild": "npm run generate-schemas"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5",
    "zod-to-json-schema": "^3.22.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mock-server",
    "schema-validation"
  ],
  "author": "MCP Smart Typer Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zheke32174/mcp-smart-typer.git",
    "directory": "packages/mcp-server-smart-typer"
  },
  "bugs": {
    "url": "https://github.com/Zheke32174/mcp-smart-typer/issues"
  },
  "homepage": "https://github.com/Zheke32174/mcp-smart-typer#readme",
  "publishConfig": {
    "access": "public"
  },
  "mcpSpecVersion": "1.0.0"
}
