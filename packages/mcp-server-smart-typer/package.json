{
  "name": "@mcp-smart-typer/server",
  "version": "2.0.0",
  "description": "MCP server for AI-powered typing automation with Windows UI integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-smart-typer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/simple-server.ts",
    "dev:enhanced": "tsx --watch src/enhanced-server.ts",
    "start": "tsx src/simple-server.ts",
    "start:enhanced": "tsx src/enhanced-server.ts",
    "test": "jest",
    "test:e2e": "tsx src/test/run-e2e-tests.ts",
    "test:field-detection": "jest src/test/e2e/field-detection.test.ts",
    "test:typing-accuracy": "jest src/test/e2e/typing-accuracy.test.ts",
    "test:notepad": "jest src/test/e2e/notepad-integration.test.ts",
    "test:all": "npm run test && npm run test:e2e",
    "demo:generate": "tsx src/test/generate-demo-gifs.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "generate-schemas": "tsx scripts/generate-json-schemas.ts",
    "prebuild": "npm run generate-schemas"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13",
    "zod": "^3.22.4",
    "tesseract.js": "^5.0.4",
    "sharp": "^0.33.2",
    "canvas": "^2.11.2",
    "@tensorflow/tfjs-node": "^4.15.0",
    "jimp": "^0.22.10",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "rimraf": "^5.0.5",
    "zod-to-json-schema": "^3.22.4"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "automation",
    "typing",
    "windows",
    "ui-automation",
    "grpc"
  ],
  "author": "MCP Smart Typer Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zheke32174/mcp-smart-typer.git",
    "directory": "packages/mcp-server-smart-typer"
  },
  "bugs": {
    "url": "https://github.com/Zheke32174/mcp-smart-typer/issues"
  },
  "homepage": "https://github.com/Zheke32174/mcp-smart-typer#readme",
  "mcpSpecVersion": "1.0.0"
}
